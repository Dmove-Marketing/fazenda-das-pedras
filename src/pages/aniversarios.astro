---
// ============================================================
// /aniversarios — LP do funil social (aniversários)
// ============================================================
import Base from '../layouts/Base.astro';
import '../styles/aniversarios.css';
import config from '../../config.json';
import { getPreset } from '../scripts/form-presets';

const webhookUrl = config.forms['lead-form'].webhooks[0];
const campos = getPreset('social');

const layoutLinhas: Array<{ names: string[]; extraClass?: string }> = [
  { names: ['nome'] },
  { names: ['telefone', 'email'], extraClass: 'campos-duplos--empilha-mobile' },
  { names: ['tipo_evento'] },
  { names: ['data_evento', 'convidados'], extraClass: 'campos-duplos--data' },
  { names: ['detalhes_adicionais'] },
];
const porNome = new Map(campos.map((c) => [c.name, c]));
const formRows = layoutLinhas.map((linha) =>
  linha.names.map((nome) => {
    const campo = porNome.get(nome);
    if (!campo) throw new Error('Campo "' + nome + '" não existe no preset social');
    return campo;
  })
);
if (formRows.flat().length !== campos.length) {
  throw new Error('layoutLinhas cobre ' + formRows.flat().length + ' campos, o preset tem ' + campos.length);
}

const autoComplete: Record<string, string> = {
  nome: 'name',
  telefone: 'tel',
  email: 'email',
};

const CDN = 'https://media.dmove.com.br/clients/fazenda-das-pedras/photos';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: 'Espaço Fazenda das Pedras — Aniversários',
  description: 'Seu aniversário cercado pela natureza. Ambientes para festas de até 600 pessoas e hospedagem no local, em Itu/SP, a poucos quilômetros de São Paulo.',
  image: `${CDN}/fazendadaspedras-aniversario-hero.webp`,
  url: `https://${config.domain}/aniversarios`,
  telephone: '+5511963701306',
  maximumAttendeeCapacity: 600,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rod. Dom Gabriel Paulino Bueno Couto, s/n — km 98',
    addressLocality: 'Itu',
    addressRegion: 'SP',
    postalCode: '13304-350',
    addressCountry: 'BR',
  },
};
---

<Base
  title="Fazenda das Pedras Eventos | Festa de Aniversário em Itu/SP"
  description="Seu aniversário cercado pela natureza. Ambientes para festas de até 600 pessoas e hospedagem no local, em Itu/SP, a poucos quilômetros de São Paulo."
  ogImage={`${CDN}/fazendadaspedras-aniversario-hero.webp`}
  canonical={`https://${config.domain}/aniversarios`}
  theme="light"
  jsonLd={jsonLd}
  whatsAppMessage={'Olá! Quero planejar o meu aniversário na Fazenda das Pedras.'}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${CDN}/fazendadaspedras-aniversario-hero.webp`} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Kalista-Serif-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Gotham-Book.woff2" crossorigin />
    <script>document.documentElement.classList.add('js');</script>
  </Fragment>

  <!-- =================== HEADER / NAVEGAÇÃO =================== -->
  <header class="cabecalho" id="cabecalho">
    <div class="container cabecalho__barra">
      <a href="#topo" aria-label="Fazenda das Pedras Eventos — voltar ao início">
        <img class="cabecalho__logo" src="/images/casamentos/logo-horizontal-escuro.svg" alt="Espaço Fazenda das Pedras Eventos">
      </a>
      <input type="checkbox" id="alterna-menu" class="somente-leitor">
      <label for="alterna-menu" class="cabecalho__botao-menu" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </label>
      <nav class="cabecalho__nav" aria-label="Navegação principal">
        <a href="#sobre">Sobre</a>
        <a href="#ambientes">Ambientes</a>
        <a href="#infraestrutura">Estrutura</a>
        <a href="#hospedagem">Hospedagem</a>
        <a href="#galeria">Galeria</a>
        <a href="#localizacao">Localização</a>
        <a href="#contato">Contato</a>
      </nav>
    </div>
  </header>

  <main>

    <!-- =================== HERO =================== -->
    <section class="hero" id="topo">
      <div class="hero__midia">
        <img src={`${CDN}/fazendadaspedras-aniversario-hero.webp`} alt="Festa de aniversário montada no jardim da Fazenda das Pedras ao entardecer, em Itu/SP" fetchpriority="high" decoding="sync">
      </div>
      <div class="container hero__conteudo">
        <h1 class="hero__titulo">Seu aniversário<br> cercado pela<br> natureza</h1>
        <p class="hero__paragrafo">Celebre mais um ano de vida<br> com a atmosfera da Fazenda</p>
        <div class="hero__acoes">
          <a href="#contato" class="botao botao--primario">Quero planejar</a>
        </div>
        <div class="hero__destaques">
          <span class="hero__destaque">Itu/SP</span>
          <span class="hero__destaque">Até 600 pessoas</span>
          <span class="hero__destaque">Um evento por dia</span>
        </div>
      </div>
    </section>

    <!-- =================== SOBRE =================== -->
    <section id="sobre">
      <div class="container">
        <div class="sobre__grade">
          <div class="sobre__foto revelar">
            <img src={`${CDN}/fazendadaspedras-aniversario-sobre.webp`} alt="Sede da Fazenda das Pedras com jardim e gramado" loading="lazy" decoding="async">
          </div>
          <div class="sobre__texto revelar">
            <p class="rotulo">O espaço</p>
            <h2 class="titulo-secao">Um lugar<br class="esconde-mobile"> para celebrar<br class="esconde-mobile"> a vida</h2>
            <p class="paragrafo" style="margin-top:22px;">A poucos quilômetros de São Paulo, a Fazenda das Pedras combina o clima do interior com ambientes preparados para receber sua festa de aniversário.</p>
            <p class="paragrafo">Do encontro mais descontraído à grande festa, o verde ao redor cria uma atmosfera especial para reunir as pessoas e aproveitar cada instante.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== AMBIENTES =================== -->
    <section class="cerimonia--palco fundo-creme-claro" id="ambientes">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar">
          <p class="rotulo">Ambientes</p>
          <h2 class="titulo-secao">Uma festa com a sua personalidade</h2>
          <p class="paragrafo">Escolha os ambientes e crie a atmosfera que você imaginou</p>
        </div>
        <div class="palco revelar" data-palco aria-label="Ambientes da Fazenda das Pedras">
          <button type="button" class="palco__painel ativo" aria-pressed="true" aria-label="Espaço Jatobá">
            <img src={`${CDN}/fazendadaspedras-aniversario-jatoba.webp`} alt="Festa de aniversário montada sob a copa do Jatobá" loading="lazy" decoding="async" style="object-position:50% 85%">
            <span class="palco__nome">Espaço Jatobá</span>
            <span class="palco__progresso" aria-hidden="true"></span>
          </button>
          <button type="button" class="palco__painel" aria-pressed="false" aria-label="Redário">
            <img src={`${CDN}/fazendadaspedras-aniversario-redario.webp`} alt="Mesa de festa decorada com flores no Redário" loading="lazy" decoding="async" style="object-position:50% 62%">
            <span class="palco__nome">Redário</span>
            <span class="palco__progresso" aria-hidden="true"></span>
          </button>
          <button type="button" class="palco__painel" aria-pressed="false" aria-label="Pergolado">
            <img src={`${CDN}/fazendadaspedras-aniversario-pergolado.webp`} alt="Pergolado de madeira no gramado da Fazenda" loading="lazy" decoding="async">
            <span class="palco__nome">Pergolado</span>
            <span class="palco__progresso" aria-hidden="true"></span>
          </button>
          <button type="button" class="palco__painel" aria-pressed="false" aria-label="Salão Principal">
            <img src={`${CDN}/fazendadaspedras-aniversario-salao-principal.webp`} alt="Salão Principal com mesas montadas e vista para o jardim" loading="lazy" decoding="async">
            <span class="palco__nome">Salão Principal</span>
            <span class="palco__progresso" aria-hidden="true"></span>
          </button>
          <button type="button" class="palco__painel" aria-pressed="false" aria-label="Espaço Rústico">
            <img src={`${CDN}/fazendadaspedras-aniversario-espaco-rustico.webp`} alt="Espaço Rústico com mesas decoradas para festa" loading="lazy" decoding="async">
            <span class="palco__nome">Espaço Rústico</span>
            <span class="palco__progresso" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </section>

    <!-- =================== DEPOIMENTO =================== -->
    <section class="depoimento" id="depoimento">
      <div class="container revelar">
        <svg class="depoimento__aspas" viewBox="0 0 44 34" fill="currentColor" aria-hidden="true"><path d="M0 34V21.2C0 9.9 5.6 2.8 16.8 0l2 4.3C12.6 6.5 9.6 10.4 9.4 16H18v18H0Zm25.4 0V21.2C25.4 9.9 31 2.8 42.2 0l1.8 4.3c-6.2 2.2-9.2 6.1-9.4 11.7H43v18H25.4Z"/></svg>
        <blockquote>
          <p class="depoimento__texto">Espaço incrível!<br> Perfeito para<br class="quebra-mobile"> festas no geral,<br class="quebra-mobile"> inclusive infantil.<br> Salões ótimos,<br class="quebra-mobile"> jardins lindos<br class="quebra-mobile"> e até redário.<br> Super recomendo!<br class="quebra-mobile"> Nós amamos!</p>
        </blockquote>
        <p class="depoimento__autor">Katiely Santos</p>
      </div>
    </section>

    <!-- =================== INFRAESTRUTURA =================== -->
    <section class="fundo-creme" id="infraestrutura">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar" style="margin-bottom:48px;">
          <p class="rotulo">Infraestrutura</p>
          <h2 class="titulo-secao">Para você só se preocupar em aproveitar</h2>
          <p class="paragrafo infra__subtitulo">Uma estrutura completa para receber<br class="quebra-mobile"> seus convidados com conforto</p>
        </div>
        <div class="infra__layout">
          <div class="carrossel revelar" data-carrossel>
            <div class="carrossel__viewport">
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-infra-1.webp`} data-lightbox="infra"><img src={`${CDN}/fazendadaspedras-aniversario-infra-1.webp`} alt="Mesas montadas no jardim com ombrelones" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-infra-2.webp`} data-lightbox="infra"><img src={`${CDN}/fazendadaspedras-aniversario-infra-2.webp`} alt="Mesas no gramado sob as árvores" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-infra-3.webp`} data-lightbox="infra"><img src={`${CDN}/fazendadaspedras-aniversario-infra-3.webp`} alt="Varanda coberta com mesa posta" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-infra-4.webp`} data-lightbox="infra"><img src={`${CDN}/fazendadaspedras-aniversario-infra-4.webp`} alt="Recepção no jardim ao pôr do sol" loading="lazy" decoding="async" style="object-position:50% 100%"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-infra-5.webp`} data-lightbox="infra"><img src={`${CDN}/fazendadaspedras-aniversario-infra-5.webp`} alt="Mesa de bolo decorada em festa no jardim" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-infra-6.webp`} data-lightbox="infra"><img src={`${CDN}/fazendadaspedras-aniversario-infra-6.webp`} alt="Piquenique montado no gramado da Fazenda" loading="lazy" decoding="async"></a></div>
            </div>
          </div>
          <div class="infra__grade revelar">
            <div class="infra-item">
              <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1M2 12h20"/><path d="m9 3 3 2 3-2M9 21l3-2 3 2M3 9l2 3-2 3M21 9l-2 3 2 3"/></svg></span>
              <div>
                <p class="infra-item__titulo">Salão climatizado<br class="quebra-mobile"> e gerador</p>
                <p class="infra-item__texto">Conforto em qualquer clima</p>
              </div>
            </div>
            <div class="infra-item">
              <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><path d="M6 17h12"/></svg></span>
              <div>
                <p class="infra-item__titulo">Cozinha de apoio</p>
                <p class="infra-item__texto">Estrutura para sua gastronomia</p>
              </div>
            </div>
            <div class="infra-item">
              <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="m9 12 2 2 4-4"/></svg></span>
              <div>
                <p class="infra-item__titulo">Segurança e<br class="quebra-mobile"> bombeiro civil</p>
                <p class="infra-item__texto">Mais tranquilidade no evento</p>
              </div>
            </div>
            <div class="infra-item">
              <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg></span>
              <div>
                <p class="infra-item__titulo">Estacionamento<br class="quebra-mobile"> amplo</p>
                <p class="infra-item__texto">Facilidade para chegar</p>
              </div>
            </div>
            <div class="infra-item">
              <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2M15 18l-2-2"/></svg></span>
              <div>
                <p class="infra-item__titulo">Fornecedores de confiança</p>
                <p class="infra-item__texto">Indicações para completar sua festa</p>
              </div>
            </div>
            <div class="infra-item">
              <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18"/><path d="M5 10v10M19 10v10"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/><path d="M9 15h6"/></svg></span>
              <div>
                <p class="infra-item__titulo">Mobiliário<br class="quebra-mobile"> completo</p>
                <p class="infra-item__texto">Mesas e cadeiras para seus convidados</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== PARALAX =================== -->
    <section class="paralax" id="paralax" role="img" aria-label="Recepção montada no jardim da Fazenda das Pedras ao entardecer"></section>

    <!-- =================== HOSPEDAGEM =================== -->
    <section class="hospedagem" id="hospedagem">
      <div class="container">
        <div class="hospedagem__grade">
          <div class="carrossel revelar" data-carrossel>
            <div class="carrossel__viewport">
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-1.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-1.webp`} alt="Quarto de chalé com cama de casal e acabamento em madeira" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-2.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-2.webp`} alt="Chalé de tijolinho com varanda" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-3.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-3.webp`} alt="Chalé com vista para o pôr do sol" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-4.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-4.webp`} alt="Varanda de chalé com cadeiras de madeira" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-5.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-5.webp`} alt="Chalé de madeira entre as árvores e as pedras" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-6.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-6.webp`} alt="Chalés em meio ao gramado e às árvores" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-aniversario-hospedagem-7.webp`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-aniversario-hospedagem-7.webp`} alt="Chalés com telhado colonial no jardim" loading="lazy" decoding="async"></a></div>
            </div>
          </div>
          <div class="hospedagem__texto revelar">
            <p class="rotulo">Hospedagem</p>
            <h2 class="titulo-secao">Estenda a celebração<br> para o dia seguinte</h2>
            <p class="paragrafo" style="margin-top:16px;">Convide seus amigos e familiares para se hospedar na Fazenda</p>
            <div class="hospedagem__destaques">
              <span class="hospedagem__destaque">60 chalés</span>
              <span class="hospedagem__destaque">Até 150 pessoas</span>
              <span class="hospedagem__destaque">Café da manhã incluso</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== GALERIA =================== -->
    <section class="fundo-creme-claro" id="galeria">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar">
          <p class="rotulo">Galeria</p>
          <h2 class="titulo-secao">Um novo ano, um novo motivo para festejar</h2>
          <p class="paragrafo">Inspire-se em diferentes<br class="quebra-mobile"> festas para criar a sua!</p>
        </div>
        <div class="galeria__grade faixa-mobile revelar">
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-1.webp`} class="galeria__item galeria__item--alto" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-1.webp`} alt="Mesa de aniversário com tema rodeio no Salão Principal" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-4.webp`} class="galeria__item galeria__item--largo" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-4.webp`} alt="Festa de aniversário no salão decorado com balões" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-2.webp`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-2.webp`} alt="Convidados em festa com iluminação rosa no Salão Principal" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-3.webp`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-3.webp`} alt="Aniversário infantil sob o pergolado no jardim" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-5.webp`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-5.webp`} alt="Mesa de aniversário infantil com tema fazendinha" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-6.webp`} class="galeria__item galeria__item--largo" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-6.webp`} alt="Famílias reunidas em festa sob o pergolado" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-7.webp`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-7.webp`} alt="Convidados reunidos no Espaço Rústico" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-8.webp`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-8.webp`} alt="Mesa de lanches com toalha xadrez em festa de aniversário" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-aniversario-galeria-9.webp`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-aniversario-galeria-9.webp`} alt="Decoração de aniversário infantil com tema Patrulha Canina" loading="lazy" decoding="async"></a>
        </div>
      </div>
    </section>

    <!-- =================== LOCALIZAÇÃO =================== -->
    <section id="localizacao">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar">
          <p class="rotulo">Localização</p>
          <h2 class="titulo-secao">Seu aniversário com clima de interior</h2>
          <p class="paragrafo linha-unica-desktop">Em Itu, a poucos quilômetros de São Paulo, Sorocaba, Jundiaí e outras cidades da região.</p>
        </div>
        <div class="localizacao__mapa revelar">
          <iframe
            src="https://www.google.com/maps?q=Espa%C3%A7o+Fazenda+das+Pedras+Itu,+Rod.+Dom+Gabriel+Paulino+Bueno+Couto,+s%2Fn+-+km+98,+Itu+-+SP,+13304-350&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de localização — Espaço Fazenda das Pedras, Itu/SP">
          </iframe>
        </div>
      </div>
    </section>

    <!-- =================== CONTATO =================== -->
    <section class="contato" id="contato">
      <div class="container">
        <div class="contato__conteudo">
          <div class="contato__texto revelar">
            <p class="rotulo">Fale conosco</p>
            <h2 class="titulo-secao">Vamos planejar o seu aniversário na Fazenda das Pedras?</h2>
            <p class="paragrafo" style="margin-top:16px;">Preencha o formulário para<br class="quebra-mobile"> receber nosso contato</p>
          </div>

          <div id="form-grid">
            <form
              class="formulario revelar"
              id="lead-form"
              data-form-id="lead-form"
              data-submit-url={webhookUrl}
              data-grid-id="form-grid"
              data-success-id="form-success"
              novalidate
            >
              <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

              {formRows.map((linha, idx) => (
                <div class={linha.length > 1
                  ? `campos-duplos${layoutLinhas[idx].extraClass ? ' ' + layoutLinhas[idx].extraClass : ''}`
                  : 'campo-linha'}>
                  {linha.map((field) => (
                    <div class={`campo${field.required ? '' : ' campo--opcional'}`}>
                      <label for={`form-field-${field.name}`}>
                        {field.label}
                        {field.hint && <span> ({field.hint})</span>}
                      </label>

                      {field.type === 'select' ? (
                        <select id={`form-field-${field.name}`} name={field.name} required={field.required}>
                          {field.options?.map((opt) => (
                            <option value={opt.value} disabled={opt.disabled} selected={opt.selected}>{opt.label}</option>
                          ))}
                        </select>
                      ) : field.type === 'textarea' ? (
                        <textarea
                          id={`form-field-${field.name}`}
                          name={field.name}
                          placeholder={field.placeholder}
                          required={field.required}
                          rows={2}
                        />
                      ) : (
                        <input
                          id={`form-field-${field.name}`}
                          type={field.type}
                          name={field.name}
                          placeholder={field.placeholder}
                          required={field.required}
                          min={field.type === 'number' ? '1' : undefined}
                          autocomplete={autoComplete[field.name]}
                          inputmode={field.type === 'tel' ? 'tel' : field.type === 'number' ? 'numeric' : undefined}
                          data-datepicker={field.datepicker ? 'true' : undefined}
                        />
                      )}
                    </div>
                  ))}
                </div>
              ))}

              <div class="formulario__msg" id="leadFormMsg"></div>

              <div class="formulario__acoes">
                <button type="submit" class="botao botao--primario botao--largo form-submit">
                  <span class="btn-text">Enviar solicitação</span>
                  <span class="btn-loading">Enviando…</span>
                </button>
              </div>
            </form>

            <div class="formulario formulario--sucesso" id="form-success" role="alert">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
              </svg>
              <h3>Recebemos sua solicitação</h3>
              <p>Nossa equipe entra em contato em breve pelo WhatsApp ou e-mail para planejar o seu aniversário.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- =================== RODAPÉ =================== -->
  <footer class="rodape">
    <div class="container">
      <div class="rodape__topo">
        <a href="#topo" aria-label="Fazenda das Pedras Eventos — voltar ao início">
          <img class="rodape__logo" src="/images/casamentos/logo-vertical-claro.svg" alt="Espaço Fazenda das Pedras Eventos">
        </a>
      </div>
      <hr class="rodape__linha">
      <p class="rodape__copy">Copyright © 2026 Fazenda das Pedras - Todos os direitos reservados</p>
    </div>
  </footer>

  <!-- Lightbox (preenchido via JS, apenas desktop) -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Foto ampliada">
    <button class="lightbox__botao lightbox__fechar" type="button" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <button class="lightbox__botao lightbox__prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
    <img class="lightbox__img" src="" alt="">
    <button class="lightbox__botao lightbox__next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
</Base>

<script>
  import { initForms } from '../scripts/forms';
  import { initCarrosseis, initPalco, initLightbox, initMenu, initReveal } from '../scripts/casamentos-ui';
  import flatpickr from 'flatpickr';
  import { Portuguese } from 'flatpickr/dist/l10n/pt.js';
  import 'flatpickr/dist/flatpickr.min.css';

  initForms();
  initCarrosseis();
  initPalco();
  initLightbox();
  initMenu();
  initReveal();

  const dateEl = document.querySelector<HTMLInputElement>('[data-datepicker="true"]');
  if (dateEl) {
    flatpickr(dateEl, {
      locale: Portuguese,
      dateFormat: 'd/m/Y',
      minDate: 'today',
      allowInput: true,
      disableMobile: true,
    });
  }
</script>
