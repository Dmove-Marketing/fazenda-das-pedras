                <img class="palco__foto" alt="Salão Principal da Fazenda das Pedras" loading="lazy" data-src="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-salaoprincipal-1400.webp" data-srcset="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-salaoprincipal-320.webp 320w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-salaoprincipal-480.webp 480w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-salaoprincipal-560.webp 560w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-salaoprincipal-800.webp 800w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-salaoprincipal-1400.webp 1400w" data-sizes="(min-width: 1100px) 930px, (min-width: 900px) 83vw, (min-width: 700px) 102vw, 185vw" width="1400" height="933" decoding="async">
