      </div>
    </section>

    <!-- =================== INFRAESTRUTURA =================== -->
    <section class="infra" id="infraestrutura">
      <div class="container">
        <div class="cabecalho-secao centralizado">
          <p class="rotulo">Infraestrutura</p>
          <h2 class="titulo-secao">Tudo pronto para o seu time aproveitar</h2>
          <p class="paragrafo">Uma estrutura completa para que você não precise se preocupar com nada.</p>
        </div>

        <div class="infra__grade">
          <div class="infra-item">
            <span class="infra-item__icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1M2 12h20"/></svg>
            </span>
            <div>
              <p class="infra-item__titulo">Salão climatizado</p>
              <p class="infra-item__texto">Conforto em qualquer clima</p>
            </div>
          </div>
          <div class="infra-item">
            <span class="infra-item__icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
            </span>
