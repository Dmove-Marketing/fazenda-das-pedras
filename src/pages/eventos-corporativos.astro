        </div>
      </div>
    </section>

    <!-- =================== SOBRE =================== -->
    <section id="sobre">
      <div class="container">
        <div class="sobre__grade">
          <div class="sobre__foto">
            <img src="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-sobre.webp" alt="Área verde e natureza preservada da Fazenda das Pedras" loading="lazy">
