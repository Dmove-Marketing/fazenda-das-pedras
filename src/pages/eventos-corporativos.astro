                <figcaption class="palco__legenda">
                  <span class="palco__numero">03</span>
                  <span class="palco__nome">Salão Principal</span>
                </figcaption>
              </figure>
              <figure class="palco__cena" aria-hidden="true">
                <img class="palco__foto" alt="Espaço Rústico da Fazenda das Pedras" loading="lazy" data-src="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-espacorustico-800.webp" data-srcset="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-espacorustico-320.webp 320w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-espacorustico-480.webp 480w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-espacorustico-560.webp 560w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-espacorustico-800.webp 800w" data-sizes="(min-width: 1100px) 720px, (min-width: 900px) 61vw, (min-width: 700px) 73vw, 99vw" width="800" height="1000" decoding="async">
