  <main>

    <!-- =================== HERO =================== -->
    <section class="hero" id="topo">
        <img class="hero__foto" src="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-hero-800.webp" srcset="https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-hero-480.webp 480w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-hero-640.webp 640w, https://media.dmove.com.br/clients/fazenda-das-pedras/photos/fazendadaspedras-corporativo-hero-800.webp 800w" sizes="100vw" width="800" height="533" alt="Confraternização de empresa ao ar livre na Fazenda das Pedras, em Itu" fetchpriority="high" decoding="sync">
    <div class="container hero__conteudo">
        <div class="hero__caixa">
          <p class="rotulo hero__eyebrow">Itu · São Paulo</p>
