---
// ============================================================
// /casamentos — LP do funil social (casamentos)
// Design: "docs para desenvolvimento/ENTREGA/fazenda-das-pedras-casamentos.html"
// ============================================================
import Base from '../layouts/Base.astro';
import '../styles/casamentos.css';
import config from '../../config.json';
import { getPreset } from '../scripts/form-presets';

const webhookUrl = config.forms['lead-form'].webhooks[0];
const campos = getPreset('social');

const layoutLinhas = [
  ['nome'],
  ['telefone', 'email'],
  ['tipo_evento'],
  ['data_evento', 'convidados'],
  ['detalhes_adicionais'],
];
const porNome = new Map(campos.map((c) => [c.name, c]));
const formRows = layoutLinhas.map((linha) =>
  linha.map((nome) => {
    const campo = porNome.get(nome);
    if (!campo) throw new Error('Campo "' + nome + '" não existe no preset social');
    return campo;
  })
);
if (formRows.flat().length !== campos.length) {
  throw new Error('layoutLinhas cobre ' + formRows.flat().length + ' campos, o preset tem ' + campos.length);
}

const autoComplete: Record<string, string> = {
  nome: 'name',
  telefone: 'tel',
  email: 'email',
};

const CDN = 'https://media.dmove.com.br/clients/fazenda-das-pedras/photos';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: 'Espaço Fazenda das Pedras — Casamentos',
  description: 'O seu casamento com atmosfera de fazenda. Cerimônia ao ar livre, festa para até 600 pessoas e hospedagem no local, em Itu/SP, a poucos quilômetros de São Paulo.',
  image: `${CDN}/fazendadaspedras-casamento-hero.jpg`,
  url: `https://${config.domain}/casamentos`,
  telephone: '+5511963701306',
  maximumAttendeeCapacity: 600,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rod. Dom Gabriel Paulino Bueno Couto, s/n — km 98',
    addressLocality: 'Itu',
    addressRegion: 'SP',
    postalCode: '13304-350',
    addressCountry: 'BR',
  },
};
---

<Base
  title="Fazenda das Pedras Eventos | Casamento no Campo em Itu/SP"
  description="O seu casamento com atmosfera de fazenda. Cerimônia ao ar livre, festa para até 600 pessoas e hospedagem no local, em Itu/SP, a poucos quilômetros de São Paulo."
  ogImage="/images/og-default.jpg"
  canonical={`https://${config.domain}/casamentos`}
  theme="light"
  jsonLd={jsonLd}
  whatsAppMessage={'Olá! Quero planejar o meu casamento na Fazenda das Pedras.'}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${CDN}/fazendadaspedras-casamento-hero.jpg`} fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Kalista-Serif-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Gotham-Book.woff2" crossorigin />
    <script>document.documentElement.classList.add('js');</script>
  </Fragment>

  <!-- =================== HEADER / NAVEGAÇÃO =================== -->
  <header class="cabecalho" id="cabecalho">
    <div class="container cabecalho__barra">
      <a href="#topo" aria-label="Fazenda das Pedras Eventos — voltar ao início">
        <img class="cabecalho__logo" src="/images/casamentos/logo-horizontal-escuro.svg" alt="Espaço Fazenda das Pedras Eventos">
      </a>
      <input type="checkbox" id="alterna-menu" class="somente-leitor">
      <label for="alterna-menu" class="cabecalho__botao-menu" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </label>
      <nav class="cabecalho__nav" aria-label="Navegação principal">
        <a href="#sobre">Sobre</a>
        <a href="#cerimonias">Cerimônias</a>
        <a href="#festa">Festa</a>
        <a href="#hospedagem">Hospedagem</a>
        <a href="#galeria">Galeria</a>
        <a href="#localizacao">Localização</a>
        <a href="#contato">Contato</a>
      </nav>
    </div>
  </header>

  <main>

    <!-- =================== HERO =================== -->
    <section class="hero" id="topo">
      <div class="hero__midia">
        <img src={`${CDN}/fazendadaspedras-casamento-hero.jpg`} alt="Noivos se beijando sob as árvores da Fazenda das Pedras, em Itu/SP" fetchpriority="high" decoding="sync">
      </div>
      <div class="container hero__conteudo">
        <h1 class="hero__titulo">O seu casamento<br> com atmosfera<br> de fazenda</h1>
        <p class="hero__paragrafo">Deixe a natureza de Itu fazer parte<br> de cada momento do seu grande dia</p>
        <div class="hero__acoes">
          <a href="#contato" class="botao botao--primario">Começar a planejar</a>
        </div>
        <div class="hero__destaques">
          <span class="hero__destaque">Itu/SP</span>
          <span class="hero__destaque">Até 600 pessoas</span>
          <span class="hero__destaque">Um evento por dia</span>
        </div>
      </div>
    </section>

    <!-- =================== SOBRE =================== -->
    <section id="sobre">
      <div class="container">
        <div class="sobre__grade">
          <div class="sobre__foto revelar">
            <img src={`${CDN}/fazendadaspedras-casamento-sobre.jpg`} alt="Noivos caminhando pelo campo da Fazenda das Pedras ao entardecer" loading="lazy" decoding="async">
          </div>
          <div class="sobre__texto revelar">
            <p class="rotulo">O espaço</p>
            <h2 class="titulo-secao">Em meio<br class="esconde-mobile"> à natureza,<br> como você<br class="esconde-mobile"> sempre sonhou</h2>
            <p class="paragrafo quebras-larga" style="margin-top:22px;">A poucos quilômetros de São Paulo, a Fazenda das Pedras<br class="quebra-larga"> une o charme do verde a ambientes preparados para<br class="quebra-larga"> grandes celebrações.</p>
            <p class="paragrafo quebras-larga">Cada momento ganha sua própria atmosfera: cerimônia<br class="quebra-larga"> entre árvores, recepção acolhedora e uma pista pronta<br class="quebra-larga"> para a festa seguir noite adentro.</p>
          </div>
        </div>
      </div>
    </section>

    <div id="cerimonias">

      <!-- =================== CERIMÔNIA NO JATOBÁ =================== -->
      <section class="cerimonia cerimonia--palco fundo-creme-claro" id="cerimonia-jatoba">
        <div class="container">
          <div class="cabecalho-secao centralizado revelar">
            <p class="rotulo">Cerimônia Jatobá</p>
            <h2 class="titulo-secao">Diga seus votos<br class="esconde-mobile"> sob o verde do Jatobá</h2>
            <p class="paragrafo quebras-mobile" style="--linha-mobile:372">Uma cerimônia ao ar livre cercada pela beleza<br class="quebra-mobile"> de uma árvore centenária</p>
          </div>
          <div class="palco revelar" data-palco aria-label="Fotos da cerimônia no Jatobá">
            <button type="button" class="palco__painel ativo" aria-pressed="true" aria-label="Foto 1 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-jatoba-1.jpg`} alt="Noivos saindo da cerimônia no Espaço Jatobá" loading="lazy" decoding="async" style="object-position:50% 40%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 2 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-jatoba-2.jpg`} alt="Convidados reunidos na cerimônia sob o Jatobá" loading="lazy" decoding="async" style="object-position:50% 50%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 3 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-jatoba-3.jpg`} alt="Altar ao ar livre sob a copa do Jatobá" loading="lazy" decoding="async" style="object-position:50% 55%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 4 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-jatoba-4.jpg`} alt="Bancos de madeira montados em frente à árvore centenária" loading="lazy" decoding="async" style="object-position:50% 50%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 5 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-jatoba-5.jpg`} alt="Beijo dos noivos no altar do Espaço Jatobá" loading="lazy" decoding="async" style="object-position:50% 25%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <!-- =================== CERIMÔNIA NO REDÁRIO =================== -->
      <section class="cerimonia cerimonia--inv" id="cerimonia-redario">
        <div class="container">
          <div class="cerimonia__grade">
            <div class="carrossel revelar" data-carrossel>
              <div class="carrossel__viewport">
                <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-redario-1.jpg`} data-lightbox="redario"><img src={`${CDN}/fazendadaspedras-casamento-redario-1.jpg`} alt="Noivos no altar da cerimônia no Redário" loading="lazy" decoding="async"></a></div>
                <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-redario-2.jpg`} data-lightbox="redario"><img src={`${CDN}/fazendadaspedras-casamento-redario-2.jpg`} alt="Corredor florido sob a cobertura de madeira do Redário" loading="lazy" decoding="async"></a></div>
                <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-redario-3.jpg`} data-lightbox="redario"><img src={`${CDN}/fazendadaspedras-casamento-redario-3.jpg`} alt="Caminho decorado com girassóis até o Redário" loading="lazy" decoding="async" style="object-position:50% 60%"></a></div>
                <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-redario-4.jpg`} data-lightbox="redario"><img src={`${CDN}/fazendadaspedras-casamento-redario-4.jpg`} alt="Tapetes e arranjos de flores no corredor do Redário" loading="lazy" decoding="async"></a></div>
                <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-redario-5.jpg`} data-lightbox="redario"><img src={`${CDN}/fazendadaspedras-casamento-redario-5.jpg`} alt="Vista do Redário entre as árvores durante a cerimônia" loading="lazy" decoding="async"></a></div>
              </div>
            </div>
            <div class="cerimonia__texto revelar">
              <p class="rotulo">Cerimônia Redário</p>
              <h2 class="titulo-secao">Um altar entre as árvores</h2>
              <p class="paragrafo">Ambiente leve e acolhedor para uma cerimônia cheia de personalidade</p>
            </div>
          </div>
        </div>
      </section>

      <!-- =================== CERIMÔNIA NO PERGOLADO =================== -->
      <section class="cerimonia cerimonia--palco fundo-creme-claro" id="cerimonia-pergolado">
        <div class="container">
          <div class="cabecalho-secao centralizado revelar">
            <p class="rotulo">Cerimônia Pergolado</p>
            <h2 class="titulo-secao">Um cantinho especial<br class="esconde-mobile"> para dizer seus votos</h2>
            <p class="paragrafo">A paisagem natural ganha um toque romântico para a troca das alianças.</p>
          </div>
          <div class="palco revelar" data-palco aria-label="Fotos da cerimônia no Pergolado">
            <button type="button" class="palco__painel ativo" aria-pressed="true" aria-label="Foto 1 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-pergolado-1.jpg`} alt="Jardim arborizado ao redor do Pergolado" loading="lazy" decoding="async" style="object-position:50% 50%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 2 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-pergolado-2.jpg`} alt="Beijo dos noivos em cerimônia noturna iluminada por velas e lanternas" loading="lazy" decoding="async" style="object-position:50% 50%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 3 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-pergolado-3.jpg`} alt="Cerimônia ao pôr do sol sob o Pergolado decorado com flores" loading="lazy" decoding="async" style="object-position:50% 55%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 4 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-pergolado-4.jpg`} alt="Pergolado de madeira no gramado da Fazenda das Pedras" loading="lazy" decoding="async" style="object-position:50% 50%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
            <button type="button" class="palco__painel" aria-pressed="false" aria-label="Foto 5 de 5">
              <img src={`${CDN}/fazendadaspedras-casamento-pergolado-5.jpg`} alt="Troca de votos no altar do Pergolado, cercado por árvores" loading="lazy" decoding="async" style="object-position:60% 60%">
              <span class="palco__progresso" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

    </div>

    <!-- =================== DEPOIMENTO =================== -->
    <section class="depoimento" id="depoimento">
      <div class="container revelar">
        <svg class="depoimento__aspas" viewBox="0 0 44 34" fill="currentColor" aria-hidden="true"><path d="M0 34V21.2C0 9.9 5.6 2.8 16.8 0l2 4.3C12.6 6.5 9.6 10.4 9.4 16H18v18H0Zm25.4 0V21.2C25.4 9.9 31 2.8 42.2 0l1.8 4.3c-6.2 2.2-9.2 6.1-9.4 11.7H43v18H25.4Z"/></svg>
        <blockquote>
          <p class="depoimento__texto">Realizei meu casamento neste lugar e só tenho elogios! O espaço é lindo, cheio de detalhes que tornam o ambiente ainda mais encantador. Foi o cenário perfeito para viver um dos momentos mais importantes da minha vida.</p>
        </blockquote>
        <p class="depoimento__autor">Letícia Brun</p>
      </div>
    </section>

    <!-- =================== FESTA =================== -->
    <section id="festa">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar">
          <p class="rotulo">Festa</p>
          <h2 class="titulo-secao">Do altar direto para a festa</h2>
          <p class="paragrafo quebras-desktop quebras-mobile" style="--linha-mobile:344">O Salão Principal e Espaço Rústico podem<br class="quebra-mobile"> ser usados juntos<br class="esconde-mobile"> ou separados,<br class="quebra-mobile"> de acordo com o seu estilo</p>
        </div>
        <div class="festa__grade faixa-mobile revelar">
          <a href={`${CDN}/fazendadaspedras-casamento-festa-1.jpg`} class="festa__foto" data-lightbox="festa"><img src={`${CDN}/fazendadaspedras-casamento-festa-1.jpg`} alt="Salão Principal montado para recepção de casamento" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-festa-3.jpg`} class="festa__foto" data-lightbox="festa"><img src={`${CDN}/fazendadaspedras-casamento-festa-3.jpg`} alt="Mesa posta com arranjo de rosas no Salão Principal" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-festa-4.jpg`} class="festa__foto" data-lightbox="festa"><img src={`${CDN}/fazendadaspedras-casamento-festa-4.jpg`} alt="Espaço Rústico com mesas decoradas para o jantar" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-festa-2.jpg`} class="festa__foto" data-lightbox="festa"><img src={`${CDN}/fazendadaspedras-casamento-festa-2.jpg`} alt="Convidados durante a recepção do casamento" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-festa-5.jpg`} class="festa__foto" data-lightbox="festa"><img src={`${CDN}/fazendadaspedras-casamento-festa-5.jpg`} alt="Banda ao vivo e pista de dança iluminada" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-festa-6.jpg`} class="festa__foto" data-lightbox="festa"><img src={`${CDN}/fazendadaspedras-casamento-festa-6.jpg`} alt="Salão decorado com palco e iluminação para a festa" loading="lazy" decoding="async"></a>
        </div>
      </div>
    </section>

    <!-- =================== INFRAESTRUTURA =================== -->
    <section class="fundo-creme" id="infraestrutura">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar" style="margin-bottom:48px;">
          <p class="rotulo">Infraestrutura</p>
          <h2 class="titulo-secao">Para o casal aproveitar cada detalhe</h2>
          <p class="paragrafo">Uma estrutura completa para receber<br class="quebra-mobile"> seus convidados com conforto</p>
        </div>
        <div class="infra__grade revelar">
          <div class="infra-item">
            <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1M2 12h20"/><path d="m9 3 3 2 3-2M9 21l3-2 3 2M3 9l2 3-2 3M21 9l-2 3 2 3"/></svg></span>
            <div>
              <p class="infra-item__titulo">Salão climatizado<br class="quebra-mobile"> e gerador</p>
              <p class="infra-item__texto">Conforto em qualquer clima</p>
            </div>
          </div>
          <div class="infra-item">
            <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="m9 12 2 2 4-4"/></svg></span>
            <div>
              <p class="infra-item__titulo">Segurança e<br class="quebra-mobile"> bombeiro civil</p>
              <p class="infra-item__texto">Mais tranquilidade<br class="quebra-mobile"> para todos</p>
            </div>
          </div>
          <div class="infra-item">
            <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg></span>
            <div>
              <p class="infra-item__titulo">Estacionamento<br class="quebra-mobile"> amplo</p>
              <p class="infra-item__texto">Praticidade<br class="quebra-mobile"> para chegar</p>
            </div>
          </div>
          <div class="infra-item">
            <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18"/><path d="M5 10v10M19 10v10"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/><path d="M9 15h6"/></svg></span>
            <div>
              <p class="infra-item__titulo">Mobiliário<br class="quebra-mobile"> completo</p>
              <p class="infra-item__texto">Mesas e cadeiras para recepcionar bem</p>
            </div>
          </div>
          <div class="infra-item">
            <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><path d="M6 17h12"/></svg></span>
            <div>
              <p class="infra-item__titulo">Cozinha de apoio</p>
              <p class="infra-item__texto">Estrutura para receber diferentes opções de gastronomia</p>
            </div>
          </div>
          <div class="infra-item">
            <span class="infra-item__icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2M15 18l-2-2"/></svg></span>
            <div>
              <p class="infra-item__titulo">Parceiros de confiança</p>
              <p class="infra-item__texto">Indicamos parceiros para completar seu evento</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== PARALAX =================== -->
    <section class="paralax" id="paralax" role="img" aria-label="Noivos ao pôr do sol com o véu ao vento nos campos da Fazenda das Pedras"></section>

    <!-- =================== HOSPEDAGEM =================== -->
    <section class="hospedagem" id="hospedagem">
      <div class="container">
        <div class="hospedagem__grade">
          <div class="carrossel revelar" data-carrossel>
            <div class="carrossel__viewport">
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-1.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-1.jpg`} alt="Chalé com vista para o pôr do sol" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-6.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-6.jpg`} alt="Chalés de madeira entre as árvores" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-2.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-2.jpg`} alt="Chalé cercado por pedras e vegetação" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-3.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-3.jpg`} alt="Interior de chalé com acabamento em madeira" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-5.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-5.jpg`} alt="Varanda de chalé com cadeiras de madeira" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-4.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-4.jpg`} alt="Chalés de tijolinho no jardim" loading="lazy" decoding="async"></a></div>
              <div class="carrossel__slide"><a href={`${CDN}/fazendadaspedras-casamento-hospedagem-7.jpg`} data-lightbox="hospedagem"><img src={`${CDN}/fazendadaspedras-casamento-hospedagem-7.jpg`} alt="Chalés com gramado e vista para o campo" loading="lazy" decoding="async"></a></div>
            </div>
          </div>
          <div class="hospedagem__texto revelar">
            <p class="rotulo">Hospedagem</p>
            <h2 class="titulo-secao">Estenda a celebração para o dia seguinte</h2>
            <p class="paragrafo quebras-desktop" style="margin-top:16px;">Com hospedagem na própria Fazenda, o encontro<br class="esconde-mobile"> pode continuar por mais tempo.</p>
            <div class="hospedagem__destaques">
              <span class="hospedagem__destaque">60 chalés</span>
              <span class="hospedagem__destaque">Até 80 pessoas</span>
              <span class="hospedagem__destaque">Café da manhã incluso</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================== GALERIA =================== -->
    <section class="fundo-creme-claro" id="galeria">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar">
          <p class="rotulo">Galeria</p>
          <h2 class="titulo-secao">Pelo olhar de quem viveu</h2>
          <p class="paragrafo">Veja diferentes celebrações e sonhe<br class="quebra-mobile"> com o seu grande dia</p>
        </div>
        <div class="galeria__grade faixa-mobile revelar">
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-1.jpg`} class="galeria__item galeria__item--largo" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-1.jpg`} alt="Noivos abraçados ao pôr do sol no campo" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-4.jpg`} class="galeria__item galeria__item--alto" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-4.jpg`} alt="Noivo inclina a noiva para um beijo no corredor da cerimônia" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-2.jpg`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-2.jpg`} alt="Saída dos noivos com chuva de pétalas" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-7.jpg`} class="galeria__item galeria__item--alto" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-7.jpg`} alt="Noivos ao lado de uma árvore no campo ao entardecer" loading="lazy" decoding="async" style="object-position:50% 70%"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-3.jpg`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-3.jpg`} alt="Noiva ao lado da mesa de bolo decorada com rosas" loading="lazy" decoding="async" style="object-position:30% 30%"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-6.jpg`} class="galeria__item galeria__item--largo" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-6.jpg`} alt="Cerimônia com tenda transparente e passarela espelhada" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-5.jpg`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-5.jpg`} alt="Primeira dança dos noivos na pista iluminada" loading="lazy" decoding="async"></a>
          <a href={`${CDN}/fazendadaspedras-casamento-galeria-8.jpg`} class="galeria__item" data-lightbox="galeria"><img src={`${CDN}/fazendadaspedras-casamento-galeria-8.jpg`} alt="Noivos no alto do campo com céu de fim de tarde" loading="lazy" decoding="async" style="object-position:50% 75%"></a>
        </div>
      </div>
    </section>

    <!-- =================== LOCALIZAÇÃO =================== -->
    <section id="localizacao">
      <div class="container">
        <div class="cabecalho-secao centralizado revelar">
          <p class="rotulo">Localização</p>
          <h2 class="titulo-secao">Um casamento no interior, perto de tudo</h2>
          <p class="paragrafo linha-unica-desktop">Em Itu, a poucos quilômetros de São Paulo, Sorocaba, Jundiaí e outras cidades da região.</p>
        </div>
        <div class="localizacao__mapa revelar">
          <iframe
            src="https://www.google.com/maps?q=Espa%C3%A7o+Fazenda+das+Pedras+Itu,+Rod.+Dom+Gabriel+Paulino+Bueno+Couto,+s%2Fn+-+km+98,+Itu+-+SP,+13304-350&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de localização — Espaço Fazenda das Pedras, Itu/SP">
          </iframe>
        </div>
      </div>
    </section>

    <!-- =================== CONTATO =================== -->
    <section class="contato" id="contato">
      <div class="container">
        <div class="contato__conteudo">
          <div class="contato__texto revelar">
            <p class="rotulo">Fale conosco</p>
            <h2 class="titulo-secao">Vamos planejar o seu casamento na Fazenda das Pedras?</h2>
            <p class="paragrafo" style="margin-top:16px;">Preencha o formulário para<br class="quebra-mobile"> receber nosso contato</p>
          </div>

          <div id="form-grid">
            <form
              class="formulario revelar"
              id="lead-form"
              data-form-id="lead-form"
              data-submit-url={webhookUrl}
              data-grid-id="form-grid"
              data-success-id="form-success"
              novalidate
            >
              <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

              {formRows.map((linha) => (
                <div class={linha.length > 1 ? 'campos-duplos' : 'campo-linha'}>
                  {linha.map((field) => (
                    <div class={`campo${field.required ? '' : ' campo--opcional'}`}>
                      <label for={`form-field-${field.name}`}>
                        {field.label}
                        {field.hint && <span> ({field.hint})</span>}
                      </label>

                      {field.type === 'select' ? (
                        <select id={`form-field-${field.name}`} name={field.name} required={field.required}>
                          {field.options?.map((opt) => (
                            <option value={opt.value} disabled={opt.disabled} selected={opt.selected}>{opt.label}</option>
                          ))}
                        </select>
                      ) : field.type === 'textarea' ? (
                        <textarea
                          id={`form-field-${field.name}`}
                          name={field.name}
                          placeholder={field.placeholder}
                          required={field.required}
                          rows={3}
                        />
                      ) : (
                        <input
                          id={`form-field-${field.name}`}
                          type={field.type}
                          name={field.name}
                          placeholder={field.placeholder}
                          required={field.required}
                          min={field.type === 'number' ? '1' : undefined}
                          autocomplete={autoComplete[field.name]}
                          inputmode={field.type === 'tel' ? 'tel' : field.type === 'number' ? 'numeric' : undefined}
                          data-datepicker={field.datepicker ? 'true' : undefined}
                        />
                      )}
                    </div>
                  ))}
                </div>
              ))}

              <div class="formulario__msg" id="leadFormMsg"></div>

              <div class="formulario__acoes">
                <button type="submit" class="botao botao--primario botao--largo form-submit">
                  <span class="btn-text">Enviar solicitação</span>
                  <span class="btn-loading">Enviando…</span>
                </button>
              </div>
            </form>

            <div class="formulario formulario--sucesso" id="form-success" role="alert">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
              </svg>
              <h3>Recebemos sua solicitação</h3>
              <p>Nossa equipe entra em contato em breve pelo WhatsApp ou e-mail para planejar o seu casamento.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- =================== RODAPÉ =================== -->
  <footer class="rodape">
    <div class="container">
      <div class="rodape__topo">
        <a href="#topo" aria-label="Fazenda das Pedras Eventos — voltar ao início">
          <img class="rodape__logo" src="/images/casamentos/logo-vertical-claro.svg" alt="Espaço Fazenda das Pedras Eventos">
        </a>
      </div>
      <hr class="rodape__linha">
      <p class="rodape__copy">Copyright © 2026 Fazenda das Pedras - Todos os direitos reservados</p>
    </div>
  </footer>

  <!-- Lightbox (preenchido via JS, apenas desktop) -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Foto ampliada">
    <button class="lightbox__botao lightbox__fechar" type="button" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <button class="lightbox__botao lightbox__prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
    <img class="lightbox__img" src="" alt="">
    <button class="lightbox__botao lightbox__next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
</Base>

<script>
  import { initForms } from '../scripts/forms';
  import { initCarrosseis, initPalco, initLightbox, initMenu, initReveal } from '../scripts/casamentos-ui';
  import flatpickr from 'flatpickr';
  import { Portuguese } from 'flatpickr/dist/l10n/pt.js';
  import 'flatpickr/dist/flatpickr.min.css';

  initForms();
  initCarrosseis();
  initPalco();
  initLightbox();
  initMenu();
  initReveal();

  const dateEl = document.querySelector<HTMLInputElement>('[data-datepicker="true"]');
  if (dateEl) {
    flatpickr(dateEl, {
      locale: Portuguese,
      dateFormat: 'd/m/Y',
      minDate: 'today',
      allowInput: true,
      disableMobile: true,
    });
  }
</script>
